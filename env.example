# Copy this file to .env before production deployment.
# Project port: to customize the service/access port, change ONLY this line.
PORT=7001

NODE_ENV=production
HOST=0.0.0.0
DATABASE_URL=/data/ledger.db
BACKUP_DIR=/data/backups
APP_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-initial-password
REGISTRATION_OPEN=true
PUBLIC_URL=https://ledger.example.com
APP_VERSION=0.1.0
SITE_HOST=ledger.example.com
LEDGER_IMAGE=ghcr.io/iami315/financial:latest
